{
  "name": "kids-gamification",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx src/db/migrate.ts && next dev --turbopack",
    "test": "tsx --test src/lib/learn/rewards.test.ts src/lib/learn/dates.test.ts src/lib/learn/mark.test.ts src/lib/learn/time-money.test.ts src/lib/learn/boot.test.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
